import cv2
import mediapipe as mp
import pydirectinput as p1
import math
import threading
import time

# ---------------- Camera Thread ----------------
class CameraThread(threading.Thread):
    def __init__(self, device=0):
        threading.Thread.__init__(self)
        self.cap = cv2.VideoCapture(device)
        self.cap.set(3, 320)  # Width
        self.cap.set(4, 240)  # Height
        self.frame = None
        self.running = True

    def run(self):
        while self.running:
            ret, frame = self.cap.read()
            if ret:
                self.frame = cv2.flip(frame, 1)

    def stop(self):
        self.running = False
        self.cap.release()

# ---------------- Mediapipe ----------------
mp_hands = mp.solutions.hands
hands = mp_hands.Hands(static_image_mode=False,
                       max_num_hands=1,
                       min_detection_confidence=0.7,
                       min_tracking_confidence=0.7)
mp_draw = mp.solutions.drawing_utils

# ---------------- Helper ----------------
def distance(a, b):
    return math.hypot(a.x - b.x, a.y - b.y)

# ---------------- Init ----------------
cam_thread = CameraThread()
cam_thread.start()
WINDOW_NAME = "Hill Climb Palm Control"
cv2.namedWindow(WINDOW_NAME, cv2.WINDOW_NORMAL)
cv2.setWindowProperty(WINDOW_NAME, cv2.WND_PROP_TOPMOST, 1)

prev_process = 0
PROCESS_INTERVAL = 0.1  # seconds (10 FPS for processing)

last_gesture = None  # to avoid repeated keyDown

# ---------------- Main Loop ----------------
try:
    while True:
        if cam_thread.frame is None:
            continue

        frame = cam_thread.frame.copy()
        h, w, _ = frame.shape

        curr_time = time.time()
        if curr_time - prev_process >= PROCESS_INTERVAL:
            prev_process = curr_time

            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            results = hands.process(rgb)
            gesture = "NO HAND"

            if results.multi_hand_landmarks and results.multi_handedness:
                for idx, handLms in enumerate(results.multi_hand_landmarks):
                    hand_label = results.multi_handedness[idx].classification[0].label
                    if hand_label != "Right":
                        continue

                    lm = handLms.landmark
                    wrist = lm[0]
                    open_count = 0
                    finger_tips = [8, 12, 16, 20]

                    for tip in finger_tips:
                        if distance(lm[tip], wrist) > distance(lm[tip - 2], wrist):
                            open_count += 1

                    if open_count >= 3:
                        gesture = "GAS (PALM OPEN)"
                        if last_gesture != "GAS":
                            p1.keyDown('right')
                            p1.keyUp('left')
                            last_gesture = "GAS"
                    else:
                        gesture = "BRAKE (FIST)"
                        if last_gesture != "BRAKE":
                            p1.keyDown('left')
                            p1.keyUp('right')
                            last_gesture = "BRAKE"

                    mp_draw.draw_landmarks(frame, handLms, mp_hands.HAND_CONNECTIONS)
            else:
                p1.keyUp('left')
                p1.keyUp('right')
                last_gesture = None

        # ---------------- UI ----------------
        cv2.putText(frame, last_gesture or "NO HAND", (20, 40),
                    cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)
        cv2.imshow(WINDOW_NAME, frame)

        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

finally:
    cam_thread.stop()
    p1.keyUp('left')
    p1.keyUp('right')
    cv2.destroyAllWindows()
